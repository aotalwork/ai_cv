<div class="min-h-screen bg-slate-950 text-white">

  <!-- HERO -->
  <section class="mx-auto max-w-6xl px-6 py-20 lg:py-28">
    <div class="max-w-4xl">

      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-cyan-400">
        AI Professional CV
      </p>

      <h1 class="text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
        <%= @profile.name %>
      </h1>

      <p class="mt-6 text-2xl font-medium text-slate-300">
        <%= @profile.headline %>
      </p>

      <p class="mt-8 max-w-3xl text-lg leading-8 text-slate-400">
        <%= @profile.bio %>
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#ask-cv"
          class="rounded-xl bg-cyan-400 px-6 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300"
        >
          Pregúntale a mi CV →
        </a>

        <% if @profile.linkedin_url.present? %>
          <a
            href="<%= @profile.linkedin_url %>"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-slate-700 px-6 py-3 font-semibold text-white transition hover:border-slate-500"
          >
            LinkedIn
          </a>
        <% end %>

        <% if @profile.github_url.present? %>
          <a
            href="<%= @profile.github_url %>"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-slate-700 px-6 py-3 font-semibold text-white transition hover:border-slate-500"
          >
            GitHub
          </a>
        <% end %>
      </div>

    </div>
  </section>


  <!-- CAREER EVOLUTION -->
  <section class="border-y border-slate-800 bg-slate-900/50">
    <div class="mx-auto max-w-6xl px-6 py-16">

      <p class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
        Career evolution
      </p>

      <div class="mt-10 grid gap-4 md:grid-cols-5">

        <% [
             "Software Engineer",
             "Ruby on Rails Engineer",
             "Senior Engineer",
             "Technical Lead",
             "PMO"
           ].each_with_index do |role, index| %>

          <div class="rounded-2xl border border-slate-800 bg-slate-950 p-6">
            <div class="text-sm text-slate-500">
              0<%= index + 1 %>
            </div>

            <div class="mt-4 font-semibold">
              <%= role %>
            </div>
          </div>

        <% end %>

      </div>
    </div>
  </section>


  <!-- EXPERIENCE -->
  <section class="mx-auto max-w-6xl px-6 py-20">

    <p class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
      Experience
    </p>

    <h2 class="mt-3 text-4xl font-bold">
      Professional experience
    </h2>

    <div class="mt-12 space-y-8">

      <% @experiences.each do |experience| %>

        <article class="rounded-2xl border border-slate-800 bg-slate-900 p-8">

          <div class="flex flex-col justify-between gap-4 md:flex-row">

            <div>
              <h3 class="text-2xl font-bold">
                <%= experience.position %>
              </h3>

              <p class="mt-2 text-lg text-cyan-400">
                <%= experience.company %>
              </p>

              <% if experience.client.present? %>
                <p class="mt-1 text-sm text-slate-500">
                  Client: <%= experience.client %>
                </p>
              <% end %>
            </div>

            <div class="text-sm text-slate-500 md:text-right">
              <%= experience.start_date&.strftime("%m/%Y") %>
              —
              <%= experience.end_date&.strftime("%m/%Y") || "Present" %>
            </div>

          </div>

          <p class="mt-6 whitespace-pre-line leading-7 text-slate-400">
            <%= experience.description %>
          </p>

          <% if experience.technologies.present? %>
            <div class="mt-6 flex flex-wrap gap-2">
              <% experience.technologies.split(",").each do |technology| %>
                <span class="rounded-full bg-slate-800 px-3 py-1 text-xs text-slate-300">
                  <%= technology.strip %>
                </span>
              <% end %>
            </div>
          <% end %>

        </article>

      <% end %>

    </div>
  </section>


  <!-- SKILLS -->
  <section class="bg-slate-900/50">
    <div class="mx-auto max-w-6xl px-6 py-20">

      <p class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
        Skills
      </p>

      <h2 class="mt-3 text-4xl font-bold">
        Technologies & capabilities
      </h2>

      <div class="mt-12 grid gap-8 md:grid-cols-3">

        <% @skills.group_by(&:category).each do |category, skills| %>

          <div>
            <h3 class="text-xl font-semibold">
              <%= category %>
            </h3>

            <div class="mt-5 flex flex-wrap gap-2">
              <% skills.each do |skill| %>
                <span class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300">
                  <%= skill.name %>
                </span>
              <% end %>
            </div>
          </div>

        <% end %>

      </div>
    </div>
  </section>


  <!-- CERTIFICATIONS -->
  <section class="mx-auto max-w-6xl px-6 py-20">

    <p class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
      Certifications
    </p>

    <h2 class="mt-3 text-4xl font-bold">
      Continuous learning
    </h2>

    <div class="mt-10 grid gap-4 md:grid-cols-2">

      <% @certifications.each do |certification| %>

        <div class="rounded-xl border border-slate-800 bg-slate-900 p-5">

          <div class="flex justify-between gap-4">

            <span class="font-medium">
              <%= certification.name %>
            </span>

            <% if certification.year.present? %>
              <span class="text-sm text-slate-500">
                <%= certification.year %>
              </span>
            <% end %>

          </div>

        </div>

      <% end %>

    </div>
  </section>


  <!-- EDUCATION -->
  <section class="bg-slate-900/50">
    <div class="mx-auto max-w-6xl px-6 py-20">

      <p class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
        Education
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-2">

        <% @educations.each do |education| %>

          <div class="rounded-2xl border border-slate-800 bg-slate-950 p-6">

            <h3 class="text-xl font-semibold">
              <%= education.degree %>
            </h3>

            <p class="mt-2 text-cyan-400">
              <%= education.institution %>
            </p>

            <p class="mt-3 text-sm text-slate-500">
              <%= education.start_year %>
              —
              <%= education.end_year || "Present" %>
            </p>

          </div>

        <% end %>

      </div>
    </div>
  </section>


  <!-- LANGUAGES -->
  <section class="mx-auto max-w-6xl px-6 py-20">

    <p class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
      Languages
    </p>

    <div class="mt-8 flex flex-wrap gap-3">

      <% @languages.each do |language| %>

        <div class="rounded-xl border border-slate-800 bg-slate-900 px-5 py-3">
          <span class="font-medium">
            <%= language.name %>
          </span>

          <span class="ml-2 text-sm text-slate-500">
            <%= language.level %>
          </span>
        </div>

      <% end %>

    </div>
  </section>


  <!-- RECOMMENDATION -->
  <section class="bg-slate-900/50">
    <div class="mx-auto max-w-4xl px-6 py-20">

      <p class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
        Professional recommendation
      </p>

      <% @recommendations.each do |recommendation| %>

        <blockquote class="mt-8 rounded-2xl border border-slate-800 bg-slate-950 p-8">

          <p class="text-xl leading-8 text-slate-300">
            “<%= recommendation.summary %>”
          </p>

          <footer class="mt-6">
            <div class="font-semibold">
              <%= recommendation.author %>
            </div>

            <div class="text-sm text-slate-500">
              <%= recommendation.author_role %> ·
              <%= recommendation.company %>
            </div>
          </footer>

        </blockquote>

      <% end %>

    </div>
  </section>


  <!-- AI CTA -->
  <section id="ask-cv" class="mx-auto max-w-6xl px-6 py-24">

    <div class="rounded-3xl border border-cyan-400/20 bg-cyan-400/5 p-10 text-center lg:p-16">

      <p class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
        AI Assistant
      </p>

      <h2 class="mt-4 text-4xl font-bold sm:text-5xl">
        ¿Quieres saber más sobre mi perfil?
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">
        Pregunta directamente a mi CV sobre mi experiencia,
        liderazgo, Ruby on Rails, proyectos, gestión o encaje
        con una posición.
      </p>

      <button
        type="button"
        class="mt-8 rounded-xl bg-cyan-400 px-8 py-4 font-bold text-slate-950 transition hover:bg-cyan-300"
      >
        Pregúntale a mi CV →
      </button>

    </div>

  </section>


  <!-- FOOTER -->
  <footer class="border-t border-slate-800">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 text-sm text-slate-500 md:flex-row md:justify-between">

      <span>
        <%= @profile.name %>
      </span>

      <span>
        <%= @profile.location %>
      </span>

      <span>
        <%= @profile.email %>
      </span>

    </div>
  </footer>

</div>